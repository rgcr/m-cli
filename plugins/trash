#!/usr/bin/env bash

note_msg(){
    cat<<__EOF__

Note: This requires Terminal 'Full Disk Access' permission to work properly.
       You can grant this permission in System Preferences > Security & Privacy > Privacy > Full Disk Access.
       Add your terminal application (e.g., Terminal, iTerm2) to the list and restart the terminal.
__EOF__
}

help(){
    cat<<__EOF__
Usage: m trash [OPTION]

Description: Manage the trash on MacOS

Options:
  --help        Show this help message
  --status      Show the status of the trash
  --clean       Clean the trash
__EOF__
    note_msg
}


trash_clean(){
    local user_uid
    user_uid=$(id -u)
    local cleaned_any=0

    # Home trash (includes hidden dotfiles like .DS_Store)
    if [ -d "$HOME/.Trash" ]; then
        echo "Cleaning $HOME/.Trash..."
        sudo chflags -R nouchg "$HOME/.Trash/." 2>/dev/null
        sudo find "$HOME/.Trash" -mindepth 1 -delete 2>/dev/null
        cleaned_any=1
    fi

    # Per-volume trash (each mounted volume has /Volumes/<NAME>/.Trashes/<UID>)
    if [ -d /Volumes ]; then
        for vol in /Volumes/*; do
            local vol_trash="$vol/.Trashes/$user_uid"
            if [ -d "$vol_trash" ]; then
                echo "Cleaning $vol_trash..."
                sudo chflags -R nouchg "$vol_trash/." 2>/dev/null
                sudo find "$vol_trash" -mindepth 1 -delete 2>/dev/null
                cleaned_any=1
            fi
        done
    fi

    if [ "$cleaned_any" -eq 1 ]; then
        echo "Trash cleaned successfully!"
    else
        echo "No trash found to clean."
    fi
}

trash_status(){
    local user_uid
    user_uid=$(id -u)
    local total_files=0

    if [ -d "$HOME/.Trash" ]; then
        local size
        size=$(du -sh "$HOME/.Trash" 2>/dev/null | awk '{print $1}')
        local files
        files=$(find "$HOME/.Trash" -mindepth 1 2>/dev/null | wc -l | tr -d ' ')
        echo "$HOME/.Trash: size=${size:-0B}, files=$files"
        total_files=$((total_files + files))
    fi

    if [ -d /Volumes ]; then
        for vol in /Volumes/*; do
            local vol_trash="$vol/.Trashes/$user_uid"
            if [ -d "$vol_trash" ]; then
                local size
                size=$(du -sh "$vol_trash" 2>/dev/null | awk '{print $1}')
                local files
                files=$(find "$vol_trash" -mindepth 1 2>/dev/null | wc -l | tr -d ' ')
                echo "$vol_trash: size=${size:-0B}, files=$files"
                total_files=$((total_files + files))
            fi
        done
    fi

    echo "Total files: $total_files"
}

check_privilege(){
     ls $HOME/.Trash &>/dev/null || { note_msg && exit 1; }
}

case $1 in
    --help)
        help
        ;;
    --clean)
        check_privilege
        trash_clean
        ;;
    --status)
        check_privilege
        trash_status
        ;;
    *)
        help && exit 1
        ;;
esac
