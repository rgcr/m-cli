#!/usr/bin/env bash

help(){
    cat<<__EOF__
Usage:  m dns [OPTIONS]

Description:  Manage DNS settings on macOS

Options:
  --help                Show this help message
  --list [SERVICE]      Show active DNS resolvers, or configured servers for SERVICE
  --flush               Flush local DNS cache
  --add IP [SERVICE]    Add a DNS server to SERVICE (default: primary network service).
                        If SERVICE uses automatic DNS, this sets an explicit server list.
__EOF__
}


flushdns(){
    VERSION=$(sw_vers -productVersion)
    echo "Flushing dns..."
    if echo $VERSION | grep -E '^10\.10(\.[0-3])?$' &>/dev/null; then
        sudo discoveryutil mdnsflushcache
    elif echo $VERSION | grep -E '^10\.6(\.[0-8])?$' &>/dev/null; then
        sudo dscacheutil -flushcache
    else
        sudo killall -HUP mDNSResponder
    fi
}

listdns(){
    if [ -n "$1" ]; then
        networksetup -getdnsservers "$1"
    else
        scutil --dns
    fi
}

primary_service(){
    local service_id service_name
    service_id=$(printf 'get State:/Network/Global/IPv4\nd.show\n' | scutil | \
        awk '$1 == "PrimaryService" { print $3; exit }')
    if [ -z "$service_id" ]; then
        echo "Could not find the primary network service. Specify SERVICE." >&2
        return 1
    fi

    service_name=$(printf 'get Setup:/Network/Service/%s\nd.show\n' "$service_id" | scutil | \
        awk '/UserDefinedName[[:space:]]*:/ { sub(/^.*UserDefinedName[[:space:]]*:[[:space:]]*/, ""); print; exit }')
    if [ -z "$service_name" ]; then
        echo "Could not find the primary network service name. Specify SERVICE." >&2
        return 1
    fi
    printf '%s\n' "$service_name"
}

adddns(){
    [ -z "${1}" ] && help && exit 1
    local server="$1"
    local service="$2"
    local current line
    local servers=()

    if [ -z "$service" ]; then
        service=$(primary_service) || return 1
    fi
    current=$(networksetup -getdnsservers "$service") || return 1
    if [[ "$current" != "There aren't any DNS Servers set on "* ]]; then
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            if [[ "$line" == *[[:space:]]* ]]; then
                echo "Unexpected DNS server list for '$service': $line" >&2
                return 1
            fi
            [ "$line" = "$server" ] && echo "$server is already configured for $service" && return 0
            servers+=("$line")
        done <<< "$current"
    fi

    sudo networksetup -setdnsservers "$service" "${servers[@]}" "$server" || return 1
    echo "$server added to $service"
}


case $1 in
    --help)
        help
        ;;
    --list)
        listdns "$2"
        ;;
    --add)
        shift
        adddns "$1" "$2"
        ;;
    --flush)
        flushdns
        ;;
    *)
        help && exit 1
        ;;
esac
