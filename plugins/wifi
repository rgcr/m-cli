#!/usr/bin/env bash


MAC_MAJOR=$(/usr/bin/sw_vers -productVersion | /usr/bin/awk -F. '{print $1}')

# Detect WiFi device dynamically, allow override via environment variable
_W_DEVICE=${_W_DEVICE:-$(networksetup -listallhardwareports | awk '/Wi-Fi|AirPort/{getline; print $2}')}
_W_DEVICE=${_W_DEVICE:-en0}  # fallback if detection fails

help(){
    cat<<__EOF__
Usage: m wifi [OPTIONS] [ARGUMENTS]

Description: Manage your wifi connections on macOS

Options:
  --help                      Show this help message
  --status                    Show current wifi status
  --scan                      Scan for available wifi networks
  --showpassword [ESSID]      Show the password for a wifi network
  --list                      List known wifi networks
  --forget ESSID              Forget a wifi network
  --history                   Show wifi connection history
  --disable                   Turn off wifi
  --enable                    Turn on wifi
  --connect ESSID [PASSWORD]  Connect to a wifi network (prompt for password if not provided)
  --showmenu                  Show Wi-Fi status icon in menu bar
  --hidemenu                  Hide Wi-Fi status icon in menu bar
  --menustatus                Check Wi-Fi menu bar icon visibility
__EOF__
}

wifi_status(){
    sudo wdutil info 2>/dev/null | awk '/^WIFI$/,/^BLUETOOTH$/' | grep -v '^BLUETOOTH$'
}

wifi_scan(){
    system_profiler SPAirPortDataType 2>/dev/null | awk '/Other Local Wi-Fi Networks:/,/^$/' | tail -n +2
}

wifi_history(){
    networksetup -listpreferredwirelessnetworks ${_W_DEVICE}
}

wifi_showpassword(){
    local ssid="${1}"
    security find-generic-password -D "AirPort network password" -a "$ssid" -gw
}

wifi_disable(){
    networksetup -setairportpower ${_W_DEVICE} off
}

wifi_enable(){
    networksetup -setairportpower ${_W_DEVICE} on
}

connect_network(){
    [ "$#" -lt 1  ] && help && exit 1

    local essid="$1"
    if [ "$#" -eq 1  ]; then
        read -s -r -p "Password: " password
    elif [ "$#" -eq 2 ]; then
        password="$2"
    fi
    networksetup -setairportnetwork "${_W_DEVICE}" "${essid}" "${password}"
}

wifi_list_known(){
    networksetup -listpreferredwirelessnetworks ${_W_DEVICE} | grep -v ^Preferred
}

wifi_forget(){
    if [ -z "$1" ]; then
        help && exit 1
    fi
    local essid="$1"
    sudo networksetup -removepreferredwirelessnetwork ${_W_DEVICE} "${essid}"
}

wifi_show_menu(){
    if [ "$MAC_MAJOR" -ge 11 ]; then
        defaults write com.apple.controlcenter "NSStatusItem Visible WiFi" -bool true 2>/dev/null
        defaults write com.apple.controlcenter "NSStatusItem VisibleCC WiFi" -bool true 2>/dev/null
        defaults write com.apple.controlcenter WiFi -int 18 2>/dev/null || true
        killall ControlCenter &>/dev/null || true
    else
        defaults write com.apple.systemuiserver "NSStatusItem Visible com.apple.menuextra.airport" -bool true 2>/dev/null
        killall SystemUIServer &>/dev/null || true
    fi
    echo "Wi-Fi menu bar status set to: Visible"
}

wifi_hide_menu(){
    if [ "$MAC_MAJOR" -ge 11 ]; then
        defaults write com.apple.controlcenter "NSStatusItem Visible WiFi" -bool false 2>/dev/null
        defaults write com.apple.controlcenter "NSStatusItem VisibleCC WiFi" -bool false 2>/dev/null
        defaults write com.apple.controlcenter WiFi -int 24 2>/dev/null || true
        killall ControlCenter &>/dev/null || true
    else
        defaults write com.apple.systemuiserver "NSStatusItem Visible com.apple.menuextra.airport" -bool false 2>/dev/null
        killall SystemUIServer &>/dev/null || true
    fi
    echo "Wi-Fi menu bar status set to: Hidden"
}

wifi_menu_status(){
    local status="Hidden"
    if [ "$MAC_MAJOR" -ge 11 ]; then
        local val
        val=$(defaults read com.apple.controlcenter "NSStatusItem VisibleCC WiFi" 2>/dev/null || echo "0")
        if [ "$val" = "1" ] || [ "$val" = "true" ]; then
            status="Visible"
        fi
    else
        local val
        val=$(defaults read com.apple.systemuiserver "NSStatusItem Visible com.apple.menuextra.airport" 2>/dev/null || echo "0")
        if [ "$val" = "1" ] || [ "$val" = "true" ]; then
            status="Visible"
        fi
    fi
    echo "Wi-Fi menu bar icon: $status"
}

case $1 in
    --help|help|-h)
        help
        ;;
    --scan|scan)
        wifi_scan
        ;;
    --status|status)
        wifi_status
        ;;
    --disable|disable)
        wifi_disable
        ;;
    --enable|enable)
        wifi_enable
        ;;
    --list|list)
        wifi_list_known
        ;;
    --connect|connect)
        shift
        connect_network "$@"
        ;;
    --history|history)
        shift
        wifi_history
        ;;
    --showpassword|showpassword)
        shift
        wifi_showpassword "$@"
        ;;
    --forget|forget)
        shift
        wifi_forget "$@"
        ;;
    --showmenu|showmenu)
        wifi_show_menu
        ;;
    --hidemenu|hidemenu)
        wifi_hide_menu
        ;;
    --menustatus|menustatus)
        wifi_menu_status
        ;;
    --menubar|menubar)
        case $2 in
            show|enable|on)
                wifi_show_menu
                ;;
            hide|disable|off)
                wifi_hide_menu
                ;;
            status)
                wifi_menu_status
                ;;
            *)
                wifi_menu_status
                ;;
        esac
        ;;
    *)
        help
        ;;
esac
